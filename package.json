{
	"name": "rusty-downloader",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.8",
	"scripts": {
		"tauri": "tauri",
		"dev": "tauri dev",
		"build": "tauri build --config src-tauri/tauri.bundle.json",
		"host:build": "cargo build --release -p rdl-native-host",
		"portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/portable.ps1",
		"ext:build": "node extension/build.mjs",
		"ext:test": "node --test extension/test/*.test.mjs",
		"ui:dev": "pnpm --filter ui dev",
		"ui:build": "pnpm --filter ui build",
		"ui:check": "pnpm --filter ui check"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2"
	}
}
