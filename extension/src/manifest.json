{
	"manifest_version": 3,
	"name": "Rusty Downloader",
	"short_name": "Rusty DL",
	"version": "1.1.0",
	"description": "Send links, pages and downloads to Rusty Downloader, with the cookies they need.",
	"key": "",
	"minimum_chrome_version": "116",
	"permissions": [
		"nativeMessaging",
		"contextMenus",
		"cookies",
		"downloads",
		"storage",
		"notifications",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Rusty Downloader",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/32.png",
			"32": "icons/32.png"
		}
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": false
	},
	"icons": {
		"16": "icons/32.png",
		"32": "icons/32.png",
		"48": "icons/64.png",
		"128": "icons/128.png"
	}
}
